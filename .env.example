# Copie este arquivo para ".env" e preencha os valores.
# O ".env" nunca vai para o GitHub (está no .gitignore) porque guarda segredos.

# Endereço do banco Postgres.
# Local (docker compose up -d db): postgres://postgres:postgres@127.0.0.1:5432/portfolio
# Produção: a connection string do Neon.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/portfolio

# Chave usada para assinar os logins do /admin. Use um texto longo e aleatório.
# Gere um com:  openssl rand -hex 32
PAYLOAD_SECRET=troque-por-um-texto-longo-e-aleatorio

# Token do Vercel Blob (onde as imagens ficam em produção).
# A Vercel cria esta variável sozinha quando você liga o Blob no projeto.
# No seu computador, deixe vazio: as imagens vão para a pasta media/.
BLOB_READ_WRITE_TOKEN=

# Endereço público do site (opcional). Só preencha se usar domínio próprio,
# por exemplo https://guilhermemitter.dev. Na Vercel, sem ele, o site usa
# o endereço .vercel.app automaticamente.
NEXT_PUBLIC_SERVER_URL=
